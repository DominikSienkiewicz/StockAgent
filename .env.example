# =====================================================
# StockAgent — szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij. NIE COMMITUJ .env!
# =====================================================

# --- LLM Provider ---
# Aktualnie używamy OpenAI. W przyszłości można przełączyć na Anthropic
# (zmiana wyłącznie w warstwie infrastructure/llm/, dzięki LLMPort).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # gdy przełączymy się na Anthropic

# Heterogeniczna strategia LLM — rada doradcza (15 person × N symboli =
# ~94% callsów cyklu) może działać na tańszym modelu niż główna analiza.
# Pozostaw puste, by używać `LLM_PROVIDER` także dla rady.
# Przykłady (A/B testuj przed pełnym przejściem!):
#   COUNCIL_LLM_MODEL=gpt-4o-mini                          # ten sam provider, tańszy model
#   COUNCIL_LLM_PROVIDER=anthropic
#   COUNCIL_LLM_MODEL=claude-haiku-4-5                     # tani Anthropic dla rady
# COUNCIL_LLM_PROVIDER=
# COUNCIL_LLM_MODEL=

# --- Market Data ---
FINNHUB_API_KEY=

# --- News + Sentiment (Alpha Vantage NEWS_SENTIMENT — kuratorowane finansowo) ---
# Zarejestruj się: https://www.alphavantage.co/support/#api-key
# Wiele kluczy (CSV) — gdy jeden wyczerpie limit (25 req/dobę),
# klient rotuje na następny. Załóż N kont (różne emaile) = N × 25 req/dobę.
ALPHA_VANTAGE_API_KEYS=key1,key2,key3

# --- Database (Supabase) ---
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_KEY=

# --- Konfiguracja agenta ---
# Próg zmiany ceny, powyżej którego uruchamiamy pełną analizę (0.02 = 2%)
VOLATILITY_THRESHOLD=0.02

# Lista symboli do monitorowania (CSV)
SYMBOLS=AAPL,VOO,CSPX.L

# Lista symboli będących ETF-ami / funduszami (pomijają fundamentale)
SYMBOLS_ETF=VOO,CSPX.L

# Ścieżka do pliku z wagami modelu XGBoost
ML_MODEL_PATH=data/models/price_predictor.ubj

# --- Email notifications (opcjonalne — Resend.com) ---
# Free tier: 100 mails/dobę. Konto: https://resend.com/signup
# Sandbox sender `onboarding@resend.dev` działa od razu (wymaga tylko zarejestrowanego email_to).
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=onboarding@resend.dev
DIGEST_TO_EMAIL=



