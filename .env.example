# =====================================================
# StockAgent — SEKRETY (skopiuj do .env i uzupełnij; .env NIE commituj!)
# =====================================================
# Tutaj WYŁĄCZNIE sekrety (plus lokalne przełączniki DB_WRITES_ENABLED
# i PAID_CALLS_ENABLED na końcu).
# Cały config niewrażliwy (symbole, progi, modele, providerzy, throttle, risk
# watch…) żyje w commitowanym `config.toml` — tam go edytuj. Każdą wartość
# z config.toml można nadpisać zmienną środowiskową, jeśli potrzebujesz
# lokalnego override'u.
#
# W CI: te klucze jako GitHub repo *Secrets* (workflow czyta ${{ secrets.* }}).

# --- LLM (analiza główna = Anthropic; embeddingi + rada = OpenAI) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Market data + News/Sentiment ---
FINNHUB_API_KEY=...
ALPHA_VANTAGE_API_KEYS=key1,key2,key3   # CSV — rotacja przy rate-limit
# FRED (darmowy klucz) — tylko gdy YIELD_CURVE_ENABLED=true (krzywa rentowności).
FRED_API_KEY=...

# --- Database (Supabase) ---
SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz secret (sb_secret_...) albo legacy JWT service_role. Klucz publishable
# (sb_publishable_...) albo JWT anon/authenticated zatrzymuje start (BEZ-10):
# po migracji 038 (RLS) nie odczyta ani nie zapisze żadnej tabeli.
SUPABASE_KEY=sb_secret_...               # secret / service_role key
# Connection string roli `postgres` — WYŁĄCZNIE dla workflowu „DB Migrate” (aplikacja
# go nie czyta). Dashboard → Connect → Session pooler (port 5432). Direct connection
# (db.<ref>.supabase.co) jest tylko IPv6, a runnery GitHub Actions nie mają IPv6.
# Znaki specjalne hasła (@ : / # ? % [ ]) koduj w URL-u (np. @ → %40).
SUPABASE_DB_URL=postgresql://postgres.twoj-projekt:twoje-haslo@aws-0-twoj-region.pooler.supabase.com:5432/postgres

# --- Email (Resend) — odbiorca jest sekretem; NADAWCA i włącznik są w config.toml ---
RESEND_API_KEY=re_...
DIGEST_TO_EMAIL=you@example.com

# --- SonarCloud (opcjonalne) — token włącza job `sonarcloud` w ci.yml; bez niego job
# jest pomijany (CI nie pada). Generacja: SonarCloud → My Account → Security.
# Można wypchnąć do repo przez scripts/gh-secrets-sync.sh. ---
SONAR_TOKEN=...

# --- Kanały push (Telegram/Slack) — opcjonalne; kanał aktywny gdy sekrety ustawione.
# Włącznik real-time alertów (realtime_alerts_enabled) jest w config.toml. ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
TELEGRAM_CHAT_ID=-1001234567890
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/your-webhook

# --- Heartbeat (opcjonalne, NIEZ-13) — zewnętrzny watchdog cronów (np. healthchecks.io).
# Fast Loop, Slow Loop i shock watch pingują ten URL na koniec przebiegu (porażka →
# <URL>/fail); brak pingu w oknie checku = alarm z zewnątrz, także gdy padło całe GHA.
# URL jest sekretem (UUID checku w ścieżce). Puste/brak = bez pingu. ---
HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# --- GitHub CLI (opcjonalne) — używane WYŁĄCZNIE przez scripts/gh-secrets-*.sh
# do synchronizacji repo Secrets z tym plikiem. Puste/brak → skrypty używają
# tokenu z `gh auth login`. Fine-grained PAT potrzebuje 'Secrets: Read and write'.
# Celowo puste: każda niepusta wartość (także placeholder) przesłania login `gh`.
# NIE jest czytane przez aplikację ani workflowy. ---
GH_TOKEN=

# --- Zapis do bazy (BEZ-08) — NIE sekret, ale celowo poza config.toml ---
# Lokalny run i GitHub Actions używają TEJ SAMEJ bazy Supabase. config.toml jest
# commitowany i wspólny dla obu, więc nie odróżni lokalnego runu od produkcji —
# przełącznik żyje w środowisku. false (także gdy linii brak) = run tylko do
# odczytu: odczyty idą do bazy, zapisy są pomijane z WARNING-iem, predykcja
# dostaje id dry-run-<uuid>. Workflowy, które zapisują (Fast Loop, Slow Loop,
# shock watch), ustawiają jawnie DB_WRITES_ENABLED: "true". Lokalnie włączaj
# tylko świadomie: zapis trafia do produkcyjnego track recordu.
DB_WRITES_ENABLED=false

# --- Płatne wywołania (FIN-35) — NIE sekret, ale celowo poza config.toml ---
# Lokalny run zużywał ten sam limit Alpha Vantage (25 zapytań na dobę na klucz)
# i ten sam kredyt LLM co produkcja. false (także gdy linii brak) = LLM analizy,
# rada, recap i sędzia kalibracji, Alpha Vantage (newsy, sentyment, fundamenty,
# kalendarz wyników) i embeddingi idą przez deterministyczne atrapy, z jednym
# WARNING-iem „lokalnie bez płatnych wywołań”. Workflowy, które płacą (Fast Loop,
# Slow Loop), ustawiają jawnie PAID_CALLS_ENABLED: "true". Lokalnie włączaj tylko
# świadomie. PAID_CALLS_ENABLED=false razem z DB_WRITES_ENABLED=true to odmowa
# startu: Fast Loop i Slow Loop kończą się od razu kodem 2 z ERROR-em, bo neutralne
# prognozy atrapy trafiłyby do produkcyjnego track recordu (watch i deadman nie
# płacą, więc ich to nie dotyczy).
PAID_CALLS_ENABLED=false
