# =====================================================
# StockAgent — szablon zmiennych środowiskowych
# Skopiuj do .env i uzupełnij. NIE COMMITUJ .env!
# =====================================================

# --- LLM Provider ---
# Aktualnie używamy OpenAI. W przyszłości można przełączyć na Anthropic
# (zmiana wyłącznie w warstwie infrastructure/llm/, dzięki LLMPort).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # gdy przełączymy się na Anthropic

# Heterogeniczna strategia LLM — rada doradcza (15 person × N symboli =
# ~94% callsów cyklu) może działać na tańszym modelu niż główna analiza.
# Pozostaw puste, by używać `LLM_PROVIDER` także dla rady.
# Przykłady (A/B testuj przed pełnym przejściem!):
#   COUNCIL_LLM_MODEL=gpt-4o-mini                          # ten sam provider, tańszy model
#   COUNCIL_LLM_PROVIDER=anthropic
#   COUNCIL_LLM_MODEL=claude-haiku-4-5                     # tani Anthropic dla rady
# COUNCIL_LLM_PROVIDER=
COUNCIL_LLM_MODEL=gpt-4o-mini

# Katalog z plikami JSON definiującymi członków rady doradczej. Każdy plik =
# jeden inwestor, schema: {"name": str, "style": str}. Dodanie/usunięcie
# członka = dodanie/usunięcie pliku, bez zmian w kodzie.
# Walidacja: `uv run python -m src.tools.validate_personas`
# COUNCIL_PERSONAS_DIR=data/council_personas

# --- Market Data ---
FINNHUB_API_KEY=

# --- News + Sentiment (Alpha Vantage NEWS_SENTIMENT — kuratorowane finansowo) ---
# Zarejestruj się: https://www.alphavantage.co/support/#api-key
# Wiele kluczy (CSV) — gdy jeden wyczerpie limit (25 req/dobę),
# klient rotuje na następny. Załóż N kont (różne emaile) = N × 25 req/dobę.
ALPHA_VANTAGE_API_KEYS=key1,key2,key3

# --- Database (Supabase) ---
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_KEY=

# --- Konfiguracja agenta ---
# Próg zmiany ceny, powyżej którego uruchamiamy pełną analizę (0.02 = 2%)
VOLATILITY_THRESHOLD=0.02

# Lista symboli do monitorowania (CSV). Domyślne portfolio: 43 tickery
# (big tech, AI/semis, cloud/software, cybersec, hardware, mobility, pharma, financials, ETFs).
SYMBOLS=AAPL,AMZN,GOOGL,MSFT,META,NVDA,TSLA,AMD,NET,PLTR,ORCL,UBER,TSM,ASML,ASMIY,SAP,SIEGY,NVO,DELL,IBM,MU,QCOM,CRWD,INTC,SNDK,BLK,SSNLF,TEAM,FROG,SNOW,DDOG,SAIL,OKTA,S,PANW,VT,QUAL,IHI,VB,EWY,IVV,XDWD.DE,IUSN.DE

# Lista symboli klasyfikowanych jako ETF — pomijają fetch fundamentali
# (brak per-share EPS/P/E) i zawsze dostają ValuationVerdict.UNKNOWN.
# Powinny tu trafić WSZYSTKIE tickery ETF z SYMBOLS (np. VT, QUAL, IHI, VB,
# EWY, IVV), żeby agent nie marnował kwoty AlphaVantage na puste fundamentale.
SYMBOLS_ETF=VOO,CSPX.L,XDWD.DE,IUSN.DE,VT,QUAL,IHI,VB,EWY,IVV

# --- Krypto (osobny adapter ceny: CoinGecko free, bez klucza) ---
# Routing: BTC/ETH idą do CoinGeckoAdapter zamiast Finnhuba.
# AV NEWS_SENTIMENT dostaje prefix CRYPTO: (BTC → CRYPTO:BTC).
# Fundamentale pomijane (brak EPS/P/E — jak dla ETF).










# --- Risk Watch (osobny use case — sygnały ryzyka makro) ---
# Instrumenty proxy: inverse ETFs (SH/PSQ/RWM/EUM/SQQQ), inverse Treasuries
# (TBT), gold/safe-haven (GLD), volatility (VIXY/UVXY), sovereign proxy dla
# PL (EPOL — spadek = sygnał odpływu kapitału).
RISK_SYMBOLS=EPOL,SH,PSQ,RWM,EUM,SQQQ,TBT,GLD,VIXY,UVXY
RISK_SYMBOL_TYPES=EPOL:SOVEREIGN_PROXY,SH:INVERSE_EQUITY,PSQ:INVERSE_EQUITY,RWM:INVERSE_EQUITY,EUM:INVERSE_EQUITY,SQQQ:INVERSE_EQUITY,TBT:INVERSE_TREASURY,GLD:SAFE_HAVEN,VIXY:VOLATILITY,UVXY:VOLATILITY
# Włącza adapter NBP (kursy EUR/PLN, USD/PLN — proxy stresu fiskalnego PL).
# Free API, bez klucza, bez rate-limitu — domyślnie włączone.
NBP_ENABLED=true

# --- Resilience / rate-limit ---
# Tickery, których adaptery nie ogarniają (np. EU-listed na Finnhub free).
# Pomijane bez próby fetcha — w raporcie jako "ignored", nie "error".
SYMBOLS_UNSUPPORTED_PRICE=CSPX.L,XDWD.DE,IUSN.DE
# Sleep w sekundach między symbolami — chroni OpenAI TPM przy 30+ tickerach.
SYMBOL_THROTTLE_SECONDS=2

# Ścieżka do pliku z wagami modelu XGBoost
ML_MODEL_PATH=data/models/price_predictor.ubj

# --- Email notifications (opcjonalne — Resend.com) ---
# Free tier: 100 mails/dobę. Konto: https://resend.com/signup
# Sandbox sender `onboarding@resend.dev` działa od razu (wymaga tylko zarejestrowanego email_to).
NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=onboarding@resend.dev
DIGEST_TO_EMAIL=



