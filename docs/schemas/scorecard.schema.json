{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stockagent:public-scorecard:1",
  "title": "StockAgent public scorecard",
  "description": "Machine-readable twin of the public scorecard page (WIA-81). Aggregates only: no ticker, no price, no address. A change of meaning or shape bumps schema_version; a change of the evaluation rules shows as methodology_version and protocol_hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methodology_version",
    "protocol_hash",
    "generated_on",
    "window_days",
    "n_resolved",
    "directional_hit_rate",
    "baselines",
    "calibration",
    "equity_curve"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this document's shape.",
      "const": 1
    },
    "methodology_version": {
      "description": "Version of the evaluation protocol (evaluation_protocol.toml) the metrics follow; null without a protocol.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "protocol_hash": {
      "description": "sha256 of the bytes of evaluation_protocol.toml, the same hash every v2 commitment binds; null without a protocol.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_on": {
      "description": "Publication date (UTC, ISO 8601); empty when the renderer got none.",
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "window_days": {
      "description": "Length of the track-record window in days; null when not stated.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "n_resolved": {
      "description": "Settled predictions in the window, SIDEWAYS included.",
      "type": "integer",
      "minimum": 0
    },
    "directional_hit_rate": {
      "description": "Hit rate on BULLISH/BEARISH calls; SIDEWAYS calls are counted apart, never in the denominator.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate",
        "hits",
        "directional",
        "sideways",
        "n_eff",
        "wilson_low",
        "wilson_high",
        "p_value"
      ],
      "properties": {
        "rate": { "$ref": "#/$defs/unit_or_null" },
        "hits": { "type": "integer", "minimum": 0 },
        "directional": { "type": "integer", "minimum": 0 },
        "sideways": { "type": "integer", "minimum": 0 },
        "n_eff": {
          "description": "Effective sample size: calls of one day move together.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "wilson_low": { "$ref": "#/$defs/unit_or_null" },
        "wilson_high": { "$ref": "#/$defs/unit_or_null" },
        "p_value": {
          "description": "One-sided binomial test on n_eff against the better naive directional strategy.",
          "$ref": "#/$defs/unit_or_null"
        }
      }
    },
    "baselines": {
      "description": "Naive strategies scored on the same settled moves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["always_bullish", "always_bearish", "always_sideways", "n"],
      "properties": {
        "always_bullish": { "$ref": "#/$defs/unit_or_null" },
        "always_bearish": { "$ref": "#/$defs/unit_or_null" },
        "always_sideways": { "$ref": "#/$defs/unit_or_null" },
        "n": { "type": "integer", "minimum": 0 }
      }
    },
    "calibration": {
      "description": "Declared confidence against realised hit rate, directional calls only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "brier", "brier_skill_score", "ece", "buckets"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "brier": { "$ref": "#/$defs/unit_or_null" },
        "brier_skill_score": {
          "description": "1 - brier / climatology brier; negative is worse than the base rate.",
          "type": ["number", "null"]
        },
        "ece": { "$ref": "#/$defs/unit_or_null" },
        "buckets": {
          "description": "Equal-width confidence buckets of the reliability curve.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lower", "upper", "n", "mean_confidence", "hit_rate"],
            "properties": {
              "lower": { "$ref": "#/$defs/unit" },
              "upper": { "$ref": "#/$defs/unit" },
              "n": { "type": "integer", "minimum": 1 },
              "mean_confidence": { "$ref": "#/$defs/unit" },
              "hit_rate": { "$ref": "#/$defs/unit" }
            }
          }
        }
      }
    },
    "equity_curve": {
      "description": "Paper portfolio of directional exposures, equal weight per cycle; null without trades.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost_bps",
            "crypto_cost_bps",
            "total_return",
            "max_drawdown",
            "n_trades",
            "points"
          ],
          "properties": {
            "cost_bps": {
              "description": "One-way cost per turnover in basis points (stocks and ETFs); null = gross curve.",
              "type": ["number", "null"],
              "minimum": 0
            },
            "crypto_cost_bps": { "type": ["number", "null"], "minimum": 0 },
            "total_return": { "type": "number" },
            "max_drawdown": { "type": "number", "minimum": 0 },
            "n_trades": { "type": "integer", "minimum": 1 },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "period_return", "equity"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "period_return": { "type": "number" },
                  "equity": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "unit_or_null": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  }
}
