{# Sekcja "RADA DORADCZA" w mailu fast-loop.

    Kontekst:
      verdict           — CouncilVerdict | None (None ⇒ pusty render)
      label             — etykieta PL final_recommendation (KUP/SPRZEDAJ/TRZYMAJ)
      color, bg         — kolory CSS dla final_recommendation
      opinion_rows      — list[dict]: {name, label, emoji, color, bg,
                                       confidence_pct, factors,
                                       confidence_label}
      strength_pct      — int (consensus_strength * 100)
      vote_dist         — dict {BUY:int, SELL:int, HOLD:int}
      is_split          — bool (z verdict.is_split_decision())
      strong_consensus  — bool (z verdict.has_strong_consensus())
      dissenting_views  — list[str]
#}
{%- if verdict is none -%}
{%- else -%}
<div style="margin-top:16px;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden">
  <div style="background:{{ bg }};padding:12px 16px;border-bottom:1px solid #e5e7eb">
    <span style="font-weight:700;font-size:1.05em">RADA DORADCZA</span>
    &nbsp;&nbsp;
    <span style="background:{{ color }};color:#fff;padding:2px 10px;border-radius:12px;font-weight:700">{{ label }}</span>
    &nbsp;&nbsp;
    <span style="color:#555;font-size:0.9em">Zgodność: {{ strength_pct }}%</span>
    {% if strong_consensus %}
    &nbsp;&nbsp;
    <span style="background:#dcfce7;color:#166534;padding:2px 8px;border-radius:10px;font-size:0.8em;font-weight:600">SILNY KONSENSUS</span>
    {% endif %}
    {% if is_split %}
    &nbsp;&nbsp;
    <span style="background:#fee2e2;color:#991b1b;padding:2px 8px;border-radius:10px;font-size:0.8em;font-weight:600">⚠️ PODZIELONA RADA</span>
    {% endif %}
    <div style="margin-top:6px;font-size:0.85em;color:#4b5563">
      Rozkład głosów: 🟢 {{ vote_dist["BUY"] }} KUP · 🔴 {{ vote_dist["SELL"] }} SPRZEDAJ · 🟡 {{ vote_dist["HOLD"] }} TRZYMAJ
    </div>
    <div style="margin-top:6px;font-size:0.9em;color:#374151;font-style:italic">
      &ldquo;{{ verdict.summary }}&rdquo;
    </div>
  </div>
  <table style="width:100%;border-collapse:collapse;font-size:0.9em">
    <thead>
      <tr style="background:#f3f4f6">
        <th style="padding:6px 10px;text-align:left;font-weight:600">Inwestor</th>
        <th style="padding:6px 10px;text-align:left;font-weight:600">Opinia</th>
        <th style="padding:6px 10px;text-align:center;font-weight:600">Pewność</th>
        <th style="padding:6px 10px;text-align:left;font-weight:600">Kluczowe czynniki</th>
      </tr>
    </thead>
    <tbody>
      {% for op in opinion_rows %}
      <tr style="background:{{ op.bg }}">
        <td style="padding:6px 10px;font-weight:500">{{ op.name }}</td>
        <td style="padding:6px 10px;color:{{ op.color }};font-weight:700">{{ op.emoji }} {{ op.label }}</td>
        <td style="padding:6px 10px;text-align:center">{{ op.confidence_pct }}% <span style="font-size:0.7em;color:#9ca3af">({{ op.confidence_label }})</span></td>
        <td style="padding:6px 10px;font-size:0.85em;color:#555">{{ op.factors }}</td>
      </tr>
      {% endfor %}
      {% if dissenting_views %}
      <tr>
        <td colspan="4" style="padding:8px 10px;font-size:0.85em;color:#92400e;background:#fffbeb">
          ⚠️ Głosy niezgodne: {{ dissenting_views | join("; ") }}
        </td>
      </tr>
      {% endif %}
    </tbody>
  </table>
</div>
{%- endif -%}
