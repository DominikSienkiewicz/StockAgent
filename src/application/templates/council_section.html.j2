{# Sekcja "RADA DORADCZA" w mailu fast-loop.

    Kontekst:
      verdict           — CouncilVerdict | None (None ⇒ pusty render)
      label             — etykieta PL final_recommendation (KUP/SPRZEDAJ/TRZYMAJ)
      color, bg         — kolory CSS dla final_recommendation
      opinion_rows      — list[dict]: {name, label, emoji, tone, row_tone,
                                       confidence_pct, factors,
                                       confidence_label}
                          (tone / row_tone — klasy tonu z report_styles)
      strength_pct      — int (consensus_strength * 100)
      vote_dist         — dict {BUY:int, SELL:int, HOLD:int}
      is_split          — bool (z verdict.is_split_decision())
      strong_consensus  — bool (z verdict.has_strong_consensus())
      dissenting_views  — list[str]
#}
{%- if verdict is none -%}
{%- else -%}
{#- MAIL-06 (c): układ w klasach arkusza (report_styles); kolory werdyktu inline. -#}
<div class="cx">
  <div class="cy" style="background:{{ bg }}">
    <span class="ck">RADA DORADCZA</span>
    &nbsp;&nbsp;
    <span class="cv" style="background:{{ color }}">{{ label }}</span>
    &nbsp;&nbsp;
    <span class="cs">Zgodność: {{ strength_pct }}%</span>
    {% if strong_consensus %}
    &nbsp;&nbsp;
    <span class="cg">SILNY KONSENSUS</span>
    {% endif %}
    {% if is_split %}
    &nbsp;&nbsp;
    <span class="cp">⚠️ PODZIELONA RADA</span>
    {% endif %}
    <div class="cz">
      Rozkład głosów: 🟢 {{ vote_dist["BUY"] }} KUP · 🔴 {{ vote_dist["SELL"] }} SPRZEDAJ · 🟡 {{ vote_dist["HOLD"] }} TRZYMAJ
    </div>
    <div class="cq">
      &ldquo;{{ verdict.summary }}&rdquo;
    </div>
  </div>
  <table class="ct">
    <thead>
      <tr style="background:#f3f4f6">
        <th scope="col" class="ch">Inwestor</th>
        <th scope="col" class="ch">Opinia</th>
        <th scope="col" class="ch" style="text-align:center">Pewność</th>
        <th scope="col" class="ch">Kluczowe czynniki</th>
      </tr>
    </thead>
    <tbody>
      {% for op in opinion_rows %}
      <tr class="{{ op.row_tone }}">
        <td class="cn">{{ op.name }}</td>
        <td class="co {{ op.tone }}">{{ op.emoji }} {{ op.label }}</td>
        <td class="cc">{{ op.confidence_pct }}% <span class="cl">({{ op.confidence_label }})</span></td>
        <td class="cf">{{ op.factors }}</td>
      </tr>
      {% endfor %}
      {% if dissenting_views %}
      <tr>
        <td colspan="4" class="cd">
          ⚠️ Głosy niezgodne: {{ dissenting_views | join("; ") }}
        </td>
      </tr>
      {% endif %}
    </tbody>
  </table>
</div>
{%- endif -%}
