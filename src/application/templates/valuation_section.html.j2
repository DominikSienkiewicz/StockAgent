{# Sekcja "Wycena fundamentalna" w mailu fast-loop.

    Kontekst:
      section          — ValuationSection | None (None ⇒ pusty render)
      verdict_value    — str (UNDERVALUED/FAIR/OVERVALUED/UNKNOWN)
      verdict_color    — str (CSS color)
      trailing_pe_fmt  — str (sformatowane już z fmt())
      forward_pe_fmt   — str
      peg_ratio_fmt    — str
      growth_fmt       — str (np. "10.5%" lub "—")
      fetched_at_iso   — str (section.fetched_at.isoformat())
#}
{%- if section is none -%}
{%- else -%}
<div style="margin-top:16px;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden">
  <div style="background:#f9fafb;padding:10px 16px;border-bottom:1px solid #e5e7eb">
    <span style="font-weight:700;font-size:1.0em">Wycena fundamentalna</span>
    &nbsp;&nbsp;
    <span style="background:{{ verdict_color }};color:#fff;padding:2px 10px;border-radius:12px;font-weight:700">{{ verdict_value }}</span>
  </div>
  <table style="width:100%;border-collapse:collapse;font-size:0.9em">
    <tr>
      <td style="padding:6px 14px;color:#4b5563">Trailing P/E</td>
      <td style="padding:6px 14px;font-weight:500">{{ trailing_pe_fmt }}</td>
      <td style="padding:6px 14px;color:#4b5563">Forward P/E</td>
      <td style="padding:6px 14px;font-weight:500">{{ forward_pe_fmt }}</td>
    </tr>
    <tr style="background:#f9fafb">
      <td style="padding:6px 14px;color:#4b5563">PEG ratio</td>
      <td style="padding:6px 14px;font-weight:500">{{ peg_ratio_fmt }}</td>
      <td style="padding:6px 14px;color:#4b5563">EPS growth YoY</td>
      <td style="padding:6px 14px;font-weight:500">{{ growth_fmt }}</td>
    </tr>
  </table>
  <div style="padding:6px 14px;font-size:0.8em;color:#9ca3af">Dane fundamentalne pobrane: {{ fetched_at_iso }}</div>
</div>
{%- endif -%}
